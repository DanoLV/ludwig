{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/Ludwig.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb-nodebuginfod.sh",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "WSL2/GDB15: no lanzar el inferior via shell (evita 'Failed to set controlling terminal')",
                    "text": "-gdb-set startup-with-shell off",
                    "ignoreFailures": true
                },
                {
                    "description": "GDB15: no preguntar por debuginfod al arrancar (bloquea la sesion esperando respuesta)",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
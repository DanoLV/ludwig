# ===========================================================================
# T1: particula q=+1 FIJA en x = 28.00 (borde; ref = misma, desplazada -16 en x).
# e0 = 0.1 x, paredes (0.0, 0.5), sin electrolito, 1 paso.
# La fuerza debe ser identica entre borde y ref.
# Generado por F-campo-tangencial/crear_pruebas.py
# ===========================================================================

##############################################################################
#  Corrida
##############################################################################

N_start  0
N_cycles 1

##############################################################################
#  Sistema y MPI
##############################################################################

size 32_32_34     # z: 2 nodos de pared (z = 1 y z = 34), fluido 2..33
grid 1_1_1
periodicity 1_1_1          # x, y periodicos; z cerrado por las paredes del mapa

##############################################################################
#  Fluido
##############################################################################

fluid_rho0 0.8
viscosity      0.0005      # baja, como C-particula-libre-*: respuesta rapida
viscosity_bulk 0.0005
lb_relaxation_scheme M10
lb_fluctuations 0          # sin ruido: corridas deterministas (pareja borde/ref comparable)
temperature 0.00001        # kT

##############################################################################
#  Electrocinetica
##############################################################################

free_energy fe_electro

# Campo externo TANGENCIAL a las paredes (x). Entra como salto de potencial
# en la frontera periodica; la pared sigue la rampa psi_w - e0 x.
electric_e0 0.1_0.0_0.0

electrokinetics_init uniform
electrokinetics_epsilon     1.0e4
electrokinetics_init_rho_el 0.00000000e+00   # sin electrolito
electrokinetics_rel_tol     1.0e-18
electrokinetics_abs_tol     1.0e-18
electrokinetics_multisteps  1
electrokinetics_solver_stencil 27
electrokinetics_solver_type petsc          # las paredes solo existen en PETSc

electrokinetics_z0 +1
electrokinetics_z1 -1
electrokinetics_eunit 1.0
# stencil 27 -> A0 = 6.137828 (memoria nernst_planck_A0_stencil_factor).
# d0/d1 = 0.05 NO corregido por A0: D_fisica efectiva = 0.05*6.137828 = 0.3069.
# Aqui solo se compara borde contra ref en la misma corrida, D no importa.
electrokinetics_d0 0.05
electrokinetics_d1 0.05

fe_force_method phi_gradmu_correction

##############################################################################
#  Kernel subgrid
##############################################################################

subgrid_kernel     hann    # spread/gather
subgrid_hann_order 8       # soporte 8 (krange 4, halo 4)
pm_sr_correction   no      # pm_sr no implementado con paredes
interlacing_mode   0

##############################################################################
#  Paredes a potencial constante (Asta et al. 2019)
##############################################################################

porous_media_init wall_z
electrokinetics_wall_axis z
electrokinetics_wall_potential 0.0_0.5   # inferior_superior (kT/e)
electrokinetics_electroneutral no      # las paredes llevan la carga neta

##############################################################################
#  Coloides (particulas subgrid)
##############################################################################

colloid_init from_file


##############################################################################
#  Salida
##############################################################################

default_io_mode   mpiio
default_io_format ascii
freq_statistics 100
freq_psi_resid  100
vel_io_freq     1000
freq_config     1000       # volcados completos (psi, efield, rho, ...)
config_at_end   no

colloid_io_freq 1         # posiciones (config.cds*)
colloid_io_format_output ASCII
pforce_io_freq  1         # fuerza / Esub por particula (proceced_data/)

random_seed 8361235

# ===========================================================================
# G: microgel de 20 monomeros (16 de superficie), red al azar, enlace r0 = 4.
# Neutro: q = 0 en todos los monomeros.
# Relajacion libre entre placas a psi = 0 (z = 1 y z = 34), sin campo externo,
# sin electrolito. Caja 32x32x34. Generado por G-microgel-relax/crear.py
# ===========================================================================

##############################################################################
#  Corrida
##############################################################################

N_start  0
N_cycles 20000

##############################################################################
#  Sistema y MPI
##############################################################################

size 32_32_34     # z: 2 nodos de pared (z = 1 y z = 34), fluido 2..33
grid 1_1_1
periodicity 1_1_1          # x, y periodicos; z cerrado por las paredes del mapa

##############################################################################
#  Fluido
##############################################################################

fluid_rho0 0.8
viscosity      0.05        # como MGEL-RUN: movilidad 1/(6 pi eta ah) = 21
viscosity_bulk 0.05
lb_relaxation_scheme M10
lb_fluctuations 0          # sin ruido: relajacion determinista al minimo
temperature 0.00001        # kT

##############################################################################
#  Electrocinetica
##############################################################################

free_energy fe_electro

electric_e0 0.0_0.0_0.0    # sin campo externo

electrokinetics_init uniform
electrokinetics_epsilon     1.0e4          # Bjerrum ~ 0.8
electrokinetics_init_rho_el 0.00000000e+00   # sin electrolito
electrokinetics_rel_tol     1.0e-18
electrokinetics_abs_tol     1.0e-18
electrokinetics_multisteps  1
electrokinetics_solver_stencil 27
electrokinetics_solver_type petsc          # las paredes solo existen en PETSc

electrokinetics_z0 +1
electrokinetics_z1 -1
electrokinetics_eunit 1.0
# stencil 27 -> A0 = 6.137828 (memoria nernst_planck_A0_stencil_factor).
# d0/d1 = 0.05 NO corregido por A0: D_fisica efectiva = 0.05*6.137828 = 0.3069.
# Sin electrolito no hay iones: D no interviene.
electrokinetics_d0 0.05
electrokinetics_d1 0.05

fe_force_method phi_gradmu_correction

##############################################################################
#  Kernel subgrid
##############################################################################

subgrid_kernel     hann    # spread/gather
subgrid_hann_order 8       # soporte 8 (krange 4, halo 4)
pm_sr_correction   no      # pm_sr no implementado con paredes
interlacing_mode   0

##############################################################################
#  Paredes a potencial constante (Asta et al. 2019)
##############################################################################

porous_media_init wall_z
electrokinetics_wall_axis z
electrokinetics_wall_potential 0.0_0.0   # inferior_superior (kT/e): a tierra
electrokinetics_electroneutral no      # las paredes llevan la carga imagen

##############################################################################
#  Coloides (particulas subgrid): red del microgel
##############################################################################

colloid_init from_file

# Enlaces armonicos de la red (k como MGEL-RUN; mu k = 2e-3 por paso, estable)
bond_harmonic_on 1
bond_harmonic_k  1.0e-4
bond_harmonic_r0 4.0

# Repulsion de nucleo blando entre monomeros (como MGEL-RUN): evita el colapso
soft_sphere_on      1
soft_sphere_epsilon 1.0e-5
soft_sphere_sigma   1.0
soft_sphere_nu      12
soft_sphere_cutoff  1.8

##############################################################################
#  Salida
##############################################################################

default_io_mode   mpiio
default_io_format ascii
freq_statistics 500
freq_psi_resid  500
vel_io_freq     20000
freq_config     20000      # volcado final (psi, efield, ...)
config_at_end   no

colloid_io_freq 100        # posiciones (config.cds*)
colloid_io_format_output ASCII
pforce_io_freq  100        # fuerza / Esub por particula (proceced_data/)

random_seed 8361235
